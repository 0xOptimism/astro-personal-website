---
import Layout from '../layouts/Layout.astro';
import { notFoundMarkdown } from '../lib/agent/markdown';
import { SITE_EMAIL, SITE_ORIGIN } from '../lib/site';

const recoveryLinks = [
  { href: `${SITE_ORIGIN}/`, label: 'Home', note: 'Profile of Yannis, full-stack developer' },
  { href: `${SITE_ORIGIN}/index.md`, label: 'Homepage markdown', note: 'Markdown twin of the homepage' },
  { href: `${SITE_ORIGIN}/llms.txt`, label: 'llms.txt', note: 'Agent index, when-to-use notes, and key links' },
  { href: `${SITE_ORIGIN}/sitemap.xml`, label: 'Sitemap', note: 'Machine-readable list of pages' },
  { href: `${SITE_ORIGIN}/#contact`, label: 'Contact', note: `Email ${SITE_EMAIL}` },
];
---

<Layout title="Not found | Yannis" includeJsonLd={false} canonicalPath="/404" noIndex>
  <main class="site-shell min-h-screen px-6 py-(--space-section) md:px-12 lg:px-16">
    <article class="mx-auto max-w-xl">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-(--color-accent)">
        404
      </p>
      <h1 class="mt-3 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">
        Not found
      </h1>
      <p class="mt-6 font-body text-lg leading-relaxed text-(--color-text-muted)">
        The path you requested does not exist on yannis.dev.
      </p>

      <h2 class="mt-10 font-display text-2xl font-bold tracking-tight">Where to look next</h2>
      <ul class="mt-5 space-y-3 font-body text-(--color-text-muted)">
        {
          recoveryLinks.map((link) => (
            <li>
              <a class="link-accent" href={link.href}>
                {link.label}
              </a>
              <span>: {link.note}</span>
            </li>
          ))
        }
      </ul>

      <pre class="not-found-markdown mt-10 overflow-x-auto rounded-md border border-(--color-surface-elevated) bg-(--color-surface) p-5 font-mono text-sm leading-relaxed text-(--color-text-muted)">{notFoundMarkdown()}</pre>
    </article>
  </main>
</Layout>
