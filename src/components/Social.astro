---
import data from '../data/data.json';
import Icon from './Icon.astro';
import SiteNav from './SiteNav.astro';

const { socials } = data;

interface SocialItem {
  icon: string;
  logo?: string;
  link: string;
}

const socialLabels: Record<string, string> = {
  github: 'GitHub',
  linkedin: 'LinkedIn',
  x: 'X',
};
---

<div class="flex flex-col items-center">
  <div class="social-links flex flex-wrap items-center justify-center gap-8 border-t border-(--color-surface-elevated) pt-8">
    {
      socials.map((item: SocialItem) => (
        <a
          href={item.link}
          target="_blank"
          rel="me noopener noreferrer"
          class="flex h-12 w-12 items-center justify-center rounded-full border border-(--color-surface-elevated) text-(--color-text-muted) transition-all hover:border-(--color-accent) hover:text-(--color-accent) hover:scale-110"
          aria-label={socialLabels[item.icon] ?? item.icon}
        >
          <Icon item={item} size="lg" />
        </a>
      ))
    }
  </div>
  <SiteNav currentPath="/" compact />
</div>
