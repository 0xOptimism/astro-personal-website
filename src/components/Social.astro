---
import data from '../data/data.json';
import { SITE_DOMAIN } from '../lib/site';
import Icon from './Icon.astro';

const { socials } = data;

interface SocialItem {
  icon: string;
  link: string;
}
---

<footer class="social-links flex flex-wrap items-center justify-center gap-8 border-t border-(--color-surface-elevated) pt-8">
  <p class="w-full text-center font-display text-sm tracking-[0.18em] text-(--color-text-muted)">
    {SITE_DOMAIN}
  </p>
  {
    socials.map((item: SocialItem) => (
      <a
        href={item.link}
        target="_blank"
        rel="me noopener noreferrer"
        class="flex h-12 w-12 items-center justify-center rounded-full border border-(--color-surface-elevated) text-(--color-text-muted) transition-all hover:border-(--color-accent) hover:text-(--color-accent) hover:scale-110"
        aria-label={item.icon === 'linkedin' ? 'LinkedIn' : 'GitHub'}
      >
        <Icon item={item} size="lg" />
      </a>
    ))
  }
</footer>
