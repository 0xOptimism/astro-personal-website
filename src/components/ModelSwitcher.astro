---
import { MODEL_SKINS } from '../lib/model-skins';
---

<div class="model-switcher" data-model-switcher>
  <button
    type="button"
    class="model-switcher__trigger"
    data-model-menu-trigger
    aria-controls="model-design-menu"
    aria-haspopup="menu"
    aria-expanded="false"
  >
    <span class="model-switcher__trigger-label" data-model-current>Yannis</span>
    <span class="model-switcher__chevron" aria-hidden="true" />
  </button>

  <div id="model-design-menu" class="model-switcher__menu" data-model-menu role="menu" aria-label="Design switcher" hidden inert>
    {
      MODEL_SKINS.map((model) => (
        <button
          type="button"
          class="model-switcher__option"
          data-model-option={model.id}
          data-model-skin={model.skin}
          data-model-label={model.label}
          style={`--model-accent: ${model.accent}; --model-pulse: ${model.pulse};`}
          aria-checked={model.skin === '' ? 'true' : 'false'}
          tabindex="-1"
          role="menuitemradio"
        >
          <span class="model-switcher__check" aria-hidden="true"></span>
          <span>{model.label}</span>
        </button>
      ))
    }
  </div>
</div>

<div class="model-activation" aria-hidden="true">
  <div class="model-activation__beam"></div>
  <div class="model-activation__scan"></div>
  <div class="model-activation__boot">
    <span>syncing operator</span>
    <span>locking signal</span>
    <span>dropping noise</span>
  </div>
  <div class="model-activation__core" data-model-activation-core></div>
</div>

<div class="model-frame" aria-hidden="true">
  <span class="model-frame__corner is-tl"></span>
  <span class="model-frame__corner is-tr"></span>
  <span class="model-frame__corner is-bl"></span>
  <span class="model-frame__corner is-br"></span>
</div>

<style>
  .model-switcher__menu[hidden] {
    display: none;
  }
</style>

<script>
  import {
    MODEL_FONT_STYLESHEETS,
    MODEL_SKIN_CHANGE_EVENT,
    normalizeModelSkin,
    persistModelSkin,
    type ModelSkin,
  } from '../lib/model-skins';

  const root = document.documentElement;
  const switcher = document.querySelector<HTMLElement>('[data-model-switcher]');
  const trigger = switcher?.querySelector<HTMLButtonElement>('[data-model-menu-trigger]');
  const menu = switcher?.querySelector<HTMLElement>('[data-model-menu]');
  const currentLabel = switcher?.querySelector<HTMLElement>('[data-model-current]');
  const options = Array.from(
    switcher?.querySelectorAll<HTMLButtonElement>('[data-model-option]') ?? [],
  );
  const activation = document.querySelector<HTMLElement>('.model-activation');
  const activationCore = document.querySelector<HTMLElement>('[data-model-activation-core]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let activationFrame = 0;

  const loadModelFonts = (skin: ModelSkin) => {
    const href = MODEL_FONT_STYLESHEETS[skin];
    if (!href || document.querySelector(`link[data-model-fonts="${skin}"]`)) return;
    const stylesheet = document.createElement('link');
    stylesheet.rel = 'stylesheet';
    stylesheet.href = href;
    stylesheet.dataset.modelFonts = skin;
    document.head.appendChild(stylesheet);
  };

  const setMenuOpen = (isOpen: boolean) => {
    switcher?.classList.toggle('is-open', isOpen);
    trigger?.setAttribute('aria-expanded', String(isOpen));
    if (menu) {
      menu.hidden = !isOpen;
      menu.inert = !isOpen;
    }
  };

  const focusOption = (index: number) => {
    options[(index + options.length) % options.length]?.focus();
  };

  const stopActivation = () => {
    window.cancelAnimationFrame(activationFrame);
    activation?.classList.remove('is-firing');
  };

  const setActiveSkin = (skin: ModelSkin, animate = false) => {
    const previousSkin = normalizeModelSkin(root.dataset.modelSkin);
    for (const element of [root, document.body]) {
      if (skin) element.dataset.modelSkin = skin;
      else delete element.dataset.modelSkin;
    }

    for (const option of options) {
      const isActive = option.dataset.modelSkin === skin;
      option.setAttribute('aria-checked', String(isActive));
      if (isActive) {
        const label = option.dataset.modelLabel || 'Yannis';
        if (currentLabel) currentLabel.textContent = label;
        if (activationCore) activationCore.textContent = label;
      }
    }

    persistModelSkin(skin);
    loadModelFonts(skin);
    stopActivation();
    if (animate && skin && !reducedMotion.matches) {
      activationFrame = window.requestAnimationFrame(() => {
        activation?.classList.add('is-firing');
      });
    }
    if (skin !== previousSkin) {
      window.dispatchEvent(new CustomEvent(MODEL_SKIN_CHANGE_EVENT, {
        detail: { skin, previousSkin },
      }));
    }
  };

  trigger?.addEventListener('click', () => {
    const opening = trigger.getAttribute('aria-expanded') !== 'true';
    setMenuOpen(opening);
    if (opening) {
      focusOption(Math.max(0, options.findIndex((option) => option.getAttribute('aria-checked') === 'true')));
    }
  });

  options.forEach((option) => {
    option.addEventListener('click', () => {
      const skin = normalizeModelSkin(option.dataset.modelSkin);
      setActiveSkin(skin, normalizeModelSkin(root.dataset.modelSkin) !== skin);
      setMenuOpen(false);
      trigger?.focus();
    });
  });

  switcher?.addEventListener('keydown', (event) => {
    const isOpen = trigger?.getAttribute('aria-expanded') === 'true';
    const onTrigger = document.activeElement === trigger;
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      setMenuOpen(true);
      const direction = event.key === 'ArrowDown' ? 1 : -1;
      const currentIndex = options.findIndex((option) => option === document.activeElement);
      focusOption(onTrigger ? (direction === 1 ? 0 : options.length - 1) : currentIndex + direction);
    } else if (isOpen && (event.key === 'Home' || event.key === 'End')) {
      event.preventDefault();
      focusOption(event.key === 'Home' ? 0 : options.length - 1);
    } else if (isOpen && event.key === 'Escape') {
      event.preventDefault();
      setMenuOpen(false);
      trigger?.focus();
    } else if (isOpen && event.key === 'Tab') {
      // Restore the trigger as the tab origin, then let the browser move focus.
      setMenuOpen(false);
      trigger?.focus();
    }
  });

  switcher?.addEventListener('focusout', (event) => {
    if (!(event.relatedTarget instanceof Node) || !switcher.contains(event.relatedTarget)) {
      setMenuOpen(false);
    }
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node) || !switcher?.contains(event.target)) setMenuOpen(false);
  });

  activation?.addEventListener('animationend', (event) => {
    if (event.target === activation) stopActivation();
  });
  reducedMotion.addEventListener('change', () => {
    if (reducedMotion.matches) stopActivation();
  });

  // Layout already restored the validated selection before the first paint.
  setActiveSkin(normalizeModelSkin(root.dataset.modelSkin));
</script>
