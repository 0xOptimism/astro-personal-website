---
const models = [
  {
    id: 'brand-default',
    label: 'Yannis',
    skin: '',
    accent: '#0f766e',
    pulse: '#e4a02b',
    activationLabel: 'Yannis',
  },
  {
    id: 'gpt-55-sol-high',
    label: 'GPT-5.5 Sol High',
    skin: 'gpt-55-sol-high',
    accent: '#f7d154',
    pulse: '#4cc9f0',
    activationLabel: 'gpt 5.5 sol high',
  },
  {
    id: 'grok-46',
    label: 'Grok 4.6',
    skin: 'grok-46',
    accent: '#7c6cff',
    pulse: '#ff4d8d',
    activationLabel: 'grok 4.6',
  },
  {
    id: 'kimi-k3',
    label: 'Kimi K3',
    skin: 'kimi-k3',
    accent: '#9db8ff',
    pulse: '#ffb86b',
    activationLabel: 'kimi k3',
  },
];
---

<div class="model-switcher" data-model-switcher>
  <button
    type="button"
    class="model-switcher__trigger"
    data-model-menu-trigger
    aria-haspopup="menu"
    aria-expanded="false"
  >
    <span class="model-switcher__trigger-label" data-model-current>Yannis</span>
    <span class="model-switcher__chevron" aria-hidden="true" />
  </button>

  <div class="model-switcher__menu" data-model-menu role="menu" aria-label="Model design switcher">
    {
      models.map((model) => (
      <button
        type="button"
        class="model-switcher__option"
        data-model-option={model.id}
        data-model-skin={model.skin}
        data-model-label={model.label}
        data-model-activation-label={model.activationLabel}
        style={`--model-accent: ${model.accent}; --model-pulse: ${model.pulse};`}
        aria-checked="false"
        aria-pressed="false"
        role="menuitemradio"
      >
        <span class="model-switcher__check" aria-hidden="true"></span>
        <span>{model.label}</span>
      </button>
      ))
    }
  </div>
</div>

<div class="model-activation" aria-hidden="true">
  <div class="model-activation__beam"></div>
  <div class="model-activation__scan"></div>
  <div class="model-activation__core" data-model-activation-core></div>
</div>

<div class="model-frame" aria-hidden="true">
  <span class="model-frame__corner is-tl"></span>
  <span class="model-frame__corner is-tr"></span>
  <span class="model-frame__corner is-bl"></span>
  <span class="model-frame__corner is-br"></span>
</div>

<script>
  const root = document.documentElement;
  const body = document.body;
  const switcher = document.querySelector<HTMLElement>('[data-model-switcher]');
  const trigger = document.querySelector<HTMLButtonElement>('[data-model-menu-trigger]');
  const currentLabel = document.querySelector<HTMLElement>('[data-model-current]');
  const options = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-model-option]'),
  );
  const activation = document.querySelector<HTMLElement>('.model-activation');
  const activationCore = document.querySelector<HTMLElement>('[data-model-activation-core]');
  const storageKey = 'selected-model-skin';

  const setMenuOpen = (isOpen: boolean) => {
    switcher?.classList.toggle('is-open', isOpen);
    trigger?.setAttribute('aria-expanded', String(isOpen));
  };

  const setActiveSkin = (skinId: string, animate = false) => {
    const nextSkin = skinId || '';
    root.dataset.modelSkin = nextSkin;
    body.dataset.modelSkin = nextSkin;

    options.forEach((option) => {
      const optionSkin = option.dataset.modelSkin || '';
      const isPressed = optionSkin === nextSkin;
      option.setAttribute('aria-checked', String(isPressed));
      option.setAttribute('aria-pressed', String(isPressed));

      if (isPressed && currentLabel) {
        currentLabel.textContent = option.dataset.modelLabel || 'Yannis';
      }

      if (isPressed && activationCore) {
        activationCore.textContent =
          option.dataset.modelActivationLabel || option.dataset.modelLabel || '';
      }
    });

    if (nextSkin) {
      localStorage.setItem(storageKey, nextSkin);
    } else {
      localStorage.removeItem(storageKey);
    }

    if (animate && activation) {
      activation.classList.remove('is-firing');
      window.requestAnimationFrame(() => {
        activation.classList.add('is-firing');
      });
    }
  };

  trigger?.addEventListener('click', () => {
    const isOpen = trigger.getAttribute('aria-expanded') === 'true';
    setMenuOpen(!isOpen);
  });

  options.forEach((option) => {
    option.addEventListener('click', () => {
      const skinId = option.dataset.modelSkin || '';
      const isChanging = root.dataset.modelSkin !== skinId;
      setActiveSkin(skinId, isChanging && Boolean(skinId));
      setMenuOpen(false);
    });
  });

  const savedSkin = localStorage.getItem(storageKey);
  if (savedSkin && options.some((option) => option.dataset.modelSkin === savedSkin)) {
    setActiveSkin(savedSkin);
  } else {
    setActiveSkin('');
  }

  activation?.addEventListener('animationend', (event) => {
    if (event.target === activation) {
      activation.classList.remove('is-firing');
    }
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Node) || !switcher?.contains(target)) {
      setMenuOpen(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenuOpen(false);
      trigger?.focus();
    }

    if (event.key === 'ArrowDown' && trigger === document.activeElement) {
      event.preventDefault();
      setMenuOpen(true);
      options[0]?.focus();
    }
  });
</script>
