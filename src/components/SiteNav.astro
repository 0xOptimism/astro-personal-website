---
import { SITE_NAV } from '../lib/pages';

interface Props {
  currentPath?: string;
  compact?: boolean;
}

const { currentPath, compact = false } = Astro.props;
---

<nav
  class:list={[
    'site-nav border-t border-(--color-surface-elevated)',
    compact ? 'mt-4 pt-4' : 'mt-12 pt-6',
  ]}
  aria-label="Site"
>
  <ul class="flex flex-wrap gap-x-5 gap-y-2 font-body text-sm text-(--color-text-muted)">
    {
      SITE_NAV.map((item) => (
        <li>
          {item.href === currentPath ? (
            <span aria-current="page">{item.label}</span>
          ) : (
            <a class="link-accent" href={item.href}>
              {item.label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>
