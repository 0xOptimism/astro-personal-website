---
const { item, size } = Astro.props;
const colorStyle = item.color ? { color: item.color } : {};
const logoMaskStyle = item.logo
  ? `background-color: ${item.color ?? 'currentColor'}; mask-image: url(${item.logo}); -webkit-mask-image: url(${item.logo}); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain;`
  : '';
const initial = item.mark ?? item.name?.charAt(0) ?? '?';
---

{item.logo ? (
  <span
    class={`inline-block shrink-0 ${size === 'lg' ? 'size-6' : 'size-[1.125rem]'}`}
    style={logoMaskStyle}
    aria-hidden="true"
  ></span>
  ) : item.icon === 'linkedin' ? (
  <svg
    class={size === 'lg' ? 'size-6' : 'size-4.5'}
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M19 0H5a5 5 0 0 0-5 5v14a5 5 0 0 0 5 5h14a5 5 0 0 0 5-5V5a5 5 0 0 0-5-5ZM7.12 20.45H3.56V9h3.56v11.45ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm15.11 13.02H16.9v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.36-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28Z" />
  </svg>
  ) : item.icon === 'github' ? (
  <svg
    class={size === 'lg' ? 'size-6' : 'size-[1.125rem]'}
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M12 .3A12 12 0 0 0 8.2 23.7c.6.1.82-.26.82-.58v-2.1c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.3c0 .32.22.7.83.58A12 12 0 0 0 12 .3Z" />
  </svg>
  ) : (
  <span
    class={`inline-flex size-6 items-center justify-center rounded font-display font-bold ${size === 'lg' ? 'text-base' : 'text-[0.7rem]'}`}
    style={colorStyle}
    aria-hidden="true"
  >
    {initial}
  </span>
)}
