---
import data from '../data/data.json';

const { agenticWorkflow } = data as {
  agenticWorkflow: {
    eyebrow: string;
    title: string;
    description: string;
    tools: {
      name: string;
      mark: string;
      logo?: string;
      alt?: string;
      role: string;
      description: string;
      accent: string;
    }[];
    principles: string[];
  };
};
---

<div class="workflow-layout grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
  <div class="workflow-intro">
    <h2 id="agentic-workflow-heading" class="reveal font-display text-2xl font-bold tracking-tight sm:text-3xl">
      {agenticWorkflow.title}
    </h2>
    <p class="reveal reveal-delay-1 mt-5 max-w-xl font-body text-lg leading-relaxed text-(--color-text-muted)">
      {agenticWorkflow.description}
    </p>
  </div>

  <div class="workflow-grid grid gap-3 sm:grid-cols-2">
    {
      agenticWorkflow.tools.map((tool, i: number) => (
        <article
          class="workflow-card reveal rounded-md border border-(--color-surface-elevated) bg-(--color-surface) p-5 transition-all duration-300 hover:-translate-y-1 hover:border-(--tool-accent)"
          style={`--tool-accent: ${tool.accent}; animation-delay: ${0.2 + i * 0.08}s`}
        >
          <div class="flex items-center gap-4">
            <div
              class="workflow-card__mark flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-md border border-(--color-surface-elevated) bg-(--color-bg) p-1.5 font-display text-sm font-bold text-(--tool-accent)"
            >
              {tool.logo ? (
                <img
                  src={tool.logo}
                  alt={tool.alt ?? `${tool.name} logo`}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-contain"
                />
              ) : (
                <span aria-hidden="true">{tool.mark}</span>
              )}
            </div>
            <div>
              <h3 class="workflow-card__title font-display text-lg font-semibold text-(--color-text)">
                {tool.name}
              </h3>
              <p class="workflow-card__role mt-1 font-display text-xs font-semibold uppercase tracking-[0.18em] text-(--tool-accent)">
                {tool.role}
              </p>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</div>
