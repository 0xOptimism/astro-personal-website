---
import { HERO_KICKER, HERO_LEDE_PARAGRAPHS, HERO_NAME, HERO_ROLE, PROOF_POINTS } from '../lib/site';

const solCapabilities = [
  { label: 'Product systems', value: 'Web, backend, mobile' },
  { label: 'Agent work', value: 'Scoped tasks, reviewed diffs' },
  { label: 'Commerce', value: 'Payments, Web3, e-commerce' },
];

const opusAbstract = 'The path is clear: Ethereum experiments, early medtech work, a music NFT marketplace, an ETH Denver win, and full-stack commerce at BabyBjörn.';

const opusReadings = [
  { label: 'Premise', value: 'Products over demos' },
  { label: 'Method', value: 'Reason first, then build' },
  { label: 'Range', value: 'Medtech, commerce, onchain' },
];

const opusFootnote = 'Eight years, six teams, three industries.';

const kimiTelemetry = [
  { label: 'Context window', value: '2M tokens' },
  { label: 'Time in orbit', value: '7+ years' },
  { label: 'Guidance', value: 'Agents, human taste' },
];

const grokConsoleLines = [
  { cmd: 'whoami', out: 'Yannis. Full-stack. Stockholm. Not a brand deck.' },
  { cmd: 'uptime', out: '2017 → now. Ethereum first, then product teams.' },
  { cmd: 'job --current', out: 'BabyBjörn · commerce, payments, internal tools' },
  { cmd: 'grep receipts', out: 'ETH Denver 2023 · DAO track · 600+ teams' },
  { cmd: 'agents --policy', out: 'Scoped diffs. Human taste. No autopilot.' },
];

const grokDiagnostics = [
  { label: 'signal', value: '0.92', fill: 92 },
  { label: 'noise', value: '0.11', fill: 11 },
  { label: 'agency', value: 'MAX', fill: 100 },
  { label: 'latency', value: '12ms', fill: 18 },
];

const grokChannels = PROOF_POINTS.map((point, index) => ({
  id: `CH-${String(index + 1).padStart(2, '0')}`,
  point,
}));
---

<div class="hero-block font-display">
  <div class="grok-status">
    <span class="grok-status__live" aria-hidden="true"></span>
    <p class="grok-status__channel">grok 4.6 // operator console</p>
    <p class="grok-status__locus">prod · stockholm</p>
    <p class="grok-status__clock" data-grok-clock>00:00:00Z</p>
  </div>
  <p class="hero-kicker reveal text-(--color-text-muted) text-sm uppercase tracking-[0.2em]">
    {HERO_KICKER}
  </p>
  <h1 class="hero-title mt-2 text-5xl font-extrabold tracking-tight sm:text-6xl md:text-7xl lg:text-8xl">
    {HERO_NAME}
  </h1>
  <p class="hero-role reveal reveal-delay-1 mt-3 text-2xl font-medium text-(--color-accent) sm:text-3xl md:text-4xl">
    {HERO_ROLE}
  </p>
  <div class="hero-lede reveal reveal-delay-2 mt-8 max-w-xl font-body text-lg font-normal leading-relaxed text-(--color-text-muted)">
    {
      HERO_LEDE_PARAGRAPHS.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }
  </div>
  <div class="hero-signals reveal reveal-delay-3 mt-8 flex max-w-2xl flex-wrap gap-2">
    {
      PROOF_POINTS.map((point) => (
        <span class="hero-signal rounded-md border border-(--color-surface-elevated) bg-(--color-surface) px-3 py-2 font-body text-sm text-(--color-text-muted)">
          {point}
        </span>
      ))
    }
  </div>
  <div class="sol-command-deck reveal reveal-delay-4">
    <p class="sol-command-deck__eyebrow">GPT-5.5 Sol High</p>
    <div class="sol-command-deck__grid">
      {
        solCapabilities.map((capability) => (
          <div class="sol-command-card">
            <span>{capability.label}</span>
            <strong>{capability.value}</strong>
          </div>
        ))
      }
    </div>
  </div>
  <div class="opus-brief reveal reveal-delay-4">
    <div class="opus-brief__masthead">
      <p class="opus-brief__eyebrow">Claude Opus 5</p>
      <p class="opus-brief__meta">Abstract</p>
    </div>
    <p class="opus-brief__abstract">{opusAbstract}</p>
    <div class="opus-brief__grid">
      {
        opusReadings.map((reading) => (
          <div class="opus-brief-card">
            <span>{reading.label}</span>
            <strong>{reading.value}</strong>
          </div>
        ))
      }
    </div>
    <p class="opus-brief__footnote">{opusFootnote}</p>
  </div>
  <div class="kimi-context-deck reveal reveal-delay-4">
    <div class="kimi-context-deck__header">
      <p class="kimi-context-deck__eyebrow">Kimi K3</p>
      <p class="kimi-context-deck__readout">ctx 2,000,000 / 2,000,000</p>
    </div>
    <div class="kimi-context-deck__track" aria-hidden="true">
      <span class="kimi-context-deck__fill"></span>
    </div>
    <div class="kimi-context-deck__grid">
      {
        kimiTelemetry.map((reading) => (
          <div class="kimi-context-card">
            <span>{reading.label}</span>
            <strong>{reading.value}</strong>
          </div>
        ))
      }
    </div>
  </div>
  <p class="grok-meta">
    <span>{HERO_ROLE}</span>
    <span>human in the loop</span>
    <span>live</span>
  </p>
  <div class="grok-console" aria-label="Live build console">
    <div class="grok-console__bar">
      <span>live-build</span>
      <span data-grok-packets>pkt 00412</span>
    </div>
    <ol class="grok-console__log">
      {
        grokConsoleLines.map((line) => (
          <li>
            <span class="grok-console__cmd">{line.cmd}</span>
            <span class="grok-console__out">{line.out}</span>
          </li>
        ))
      }
    </ol>
  </div>
  <div class="grok-diag" aria-label="Signal diagnostics">
    {
      grokDiagnostics.map((reading) => (
        <div class="grok-diag__item">
          <div class="grok-diag__label">
            <span>{reading.label}</span>
            <strong>{reading.value}</strong>
          </div>
          <span class="grok-diag__track" aria-hidden="true">
            <span class="grok-diag__fill" style={`--grok-fill: ${reading.fill}%`}></span>
          </span>
        </div>
      ))
    }
  </div>
  <div class="grok-channels">
    {
      grokChannels.map((channel) => (
        <div class="grok-channel">
          <span>{channel.id}</span>
          <strong>{channel.point}</strong>
        </div>
      ))
    }
  </div>
</div>

<script>
  const grokClock = document.querySelector<HTMLElement>('[data-grok-clock]');
  const grokPackets = document.querySelector<HTMLElement>('[data-grok-packets]');
  let packetCount = 412;

  const tickGrokReadouts = () => {
    if (document.body.dataset.modelSkin !== 'grok-46') {
      return;
    }

    if (grokClock) {
      grokClock.textContent = `${new Date().toISOString().slice(11, 19)}Z`;
    }

    if (grokPackets) {
      packetCount = (packetCount + 3) % 100000;
      grokPackets.textContent = `pkt ${String(packetCount).padStart(5, '0')}`;
    }
  };

  tickGrokReadouts();
  window.setInterval(tickGrokReadouts, 1000);
</script>
