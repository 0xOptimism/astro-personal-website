---
const title = "Contact";
const email = "hello@yannis.dev";
---

<section class="contact-panel">
  <p class="grok-uplink">open channel — skip the pitch, send the signal</p>
  <h2 id="contact-heading" class="reveal font-display text-2xl font-bold tracking-tight sm:text-3xl">
    {title}
  </h2>
  <p class="reveal reveal-delay-1 mt-4 font-body text-lg text-(--color-text-muted)">
    <a class="link-accent" href={`mailto:${email}`}>{email}</a>
  </p>
</section>
