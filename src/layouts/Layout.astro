---
import '../styles/global.css';
import { JSON_LD_SCRIPT } from '../lib/agent/seo';
import {
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_OG_IMAGE_ALT,
  SITE_OG_IMAGE_HEIGHT,
  SITE_OG_IMAGE_PATH,
  SITE_OG_IMAGE_WIDTH,
  SITE_ORIGIN,
  SITE_TITLE,
} from '../lib/site';

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  includeJsonLd?: boolean;
  noIndex?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  canonicalPath = '/',
  includeJsonLd = true,
  noIndex = false,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, SITE_ORIGIN).href;
const markdownUrl = `${SITE_ORIGIN}/index.md`;
const llmsUrl = `${SITE_ORIGIN}/llms.txt`;
const ogImageUrl = new URL(SITE_OG_IMAGE_PATH, SITE_ORIGIN).href;

// Umami analytics (privacy-friendly, no cookies). Set PUBLIC_UMAMI_WEBSITE_ID in production.
// Forks can use their own ID via env or leave unset to disable.
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID ?? '8f97ce4f-3008-48d3-bf4d-5ad7c34f7266';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {noIndex && <meta name="robots" content="noindex" />}
    <meta name="description" content={description} />
    <meta name="author" content={SITE_NAME} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/markdown" href={markdownUrl} />
    <link rel="describedby" href={llmsUrl} />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={SITE_OG_IMAGE_WIDTH} />
    <meta property="og:image:height" content={SITE_OG_IMAGE_HEIGHT} />
    <meta property="og:image:alt" content={SITE_OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={SITE_OG_IMAGE_ALT} />
    {includeJsonLd && <script type="application/ld+json" set:html={JSON_LD_SCRIPT} />}
    <!-- Distinctive typography: display + refined body (SKILL) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..600;1,14..32,400..600&family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&family=Sora:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0;8..60,700;1,8..60,400&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@400;500;600;700;800&family=Unbounded:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <!-- Umami analytics: privacy-friendly, no cookies, GDPR-compliant -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id={umamiWebsiteId}></script>
  </head>
  <body class="grain">
    <script is:inline>
      try {
        var skin = localStorage.getItem('selected-model-skin');
        if (skin) {
          document.documentElement.dataset.modelSkin = skin;
          document.body.dataset.modelSkin = skin;
        }
      } catch (error) {}
    </script>
    <slot />
  </body>
</html>

<style is:global>
  code {
    font-family: ui-monospace, "Cascadia Code", "Source Code Pro", Menlo, Monaco, monospace;
  }
</style>
