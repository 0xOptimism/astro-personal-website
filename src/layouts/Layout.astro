---
import '../styles/global.css';
import { JSON_LD_SCRIPT } from '../lib/agent/seo';
import {
  MODEL_FONT_STYLESHEETS,
  MODEL_SKIN_ALIASES,
  MODEL_SKIN_STORAGE_KEY,
} from '../lib/model-skins';
import {
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_OG_IMAGE_ALT,
  SITE_OG_IMAGE_HEIGHT,
  SITE_OG_IMAGE_PATH,
  SITE_OG_IMAGE_WIDTH,
  SITE_ORIGIN,
  SITE_TITLE,
} from '../lib/site';

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  includeJsonLd?: boolean;
  noIndex?: boolean;
  ogType?: 'article' | 'profile' | 'website';
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  canonicalPath = '/',
  includeJsonLd = true,
  noIndex = false,
  ogType = 'website',
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, SITE_ORIGIN).href;
const markdownUrl =
  canonicalPath === '/' ? `${SITE_ORIGIN}/index.md` : `${SITE_ORIGIN}${canonicalPath}.md`;
const llmsUrl = `${SITE_ORIGIN}/llms.txt`;
const openApiUrl = `${SITE_ORIGIN}/openapi.json`;
const apiStatusUrl = `${SITE_ORIGIN}/api/status.json`;
const mcpServerCardUrl = `${SITE_ORIGIN}/.well-known/mcp.json`;
const ogImageUrl = new URL(SITE_OG_IMAGE_PATH, SITE_ORIGIN).href;

// Umami analytics (privacy-friendly, no cookies). Set PUBLIC_UMAMI_WEBSITE_ID in production.
// Forks can use their own ID via env or leave unset to disable.
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID ?? '8f97ce4f-3008-48d3-bf4d-5ad7c34f7266';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline define:vars={{ skinAliases: MODEL_SKIN_ALIASES, fontStylesheets: MODEL_FONT_STYLESHEETS, skinStorageKey: MODEL_SKIN_STORAGE_KEY }}>
      // Restore before content is parsed, and start only the selected design's fonts.
      try {
        var storedSkin = localStorage.getItem(skinStorageKey);
        var savedSkin = Object.prototype.hasOwnProperty.call(skinAliases, storedSkin)
          ? skinAliases[storedSkin]
          : '';
        if (savedSkin) document.documentElement.dataset.modelSkin = savedSkin;
        if (fontStylesheets[savedSkin]) {
          var fontStylesheet = document.createElement('link');
          fontStylesheet.rel = 'stylesheet';
          fontStylesheet.href = fontStylesheets[savedSkin];
          fontStylesheet.dataset.modelFonts = savedSkin;
          document.head.appendChild(fontStylesheet);
        }
        if (storedSkin !== savedSkin) {
          if (savedSkin) localStorage.setItem(skinStorageKey, savedSkin);
          else localStorage.removeItem(skinStorageKey);
        }
      } catch (error) {
        // A private or restricted browser can still use the design switcher.
      }
    </script>
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImageUrl} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    {noIndex && <meta name="robots" content="noindex" />}
    <meta name="description" content={description} />
    <meta name="author" content={SITE_NAME} />
    <meta name="application-name" content={`${SITE_NAME} developer resources`} />
    <link rel="alternate" type="text/markdown" href={markdownUrl} />
    <link rel="alternate" type="application/json" title={`${SITE_NAME} OpenAPI spec`} href={openApiUrl} />
    <link rel="alternate" type="application/json" title={`${SITE_NAME} API status`} href={apiStatusUrl} />
    <link rel="mcp-server-card" type="application/mcp-server-card+json" href={mcpServerCardUrl} />
    <link rel="describedby" href={llmsUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <slot name="head" />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(SITE_OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(SITE_OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={SITE_OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={SITE_OG_IMAGE_ALT} />
    {includeJsonLd && <script type="application/ld+json" set:html={JSON_LD_SCRIPT} />}
    <!-- Umami analytics: privacy-friendly, no cookies, GDPR-compliant -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id={umamiWebsiteId}></script>
  </head>
  <body class="grain">
    <script is:inline>
      if (document.documentElement.dataset.modelSkin) {
        document.body.dataset.modelSkin = document.documentElement.dataset.modelSkin;
      }
    </script>
    <slot />
  </body>
</html>

<style is:global>
  code {
    font-family: ui-monospace, "Cascadia Code", "Source Code Pro", Menlo, Monaco, monospace;
  }
</style>
